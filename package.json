{
  "name": "lixiang-site",
  "version": "0.1.0",
  "private": true,
  "description": "历象 Lixiang Almanac · 官网（Next static export, zh/en）",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "preview": "python3 -m http.server 43125 --directory out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "assets": "node scripts/build-web-assets.mjs",
    "legal": "node scripts/vendor-legal.mjs",
    "shots": "node scripts/capture-shots.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
